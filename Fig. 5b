df<- read.csv("Gut_Family.csv",row.names = 1, header = T)
otu <- df[rowSums(df != 0) > 0, ]
ai <- abs(otu-apply(otu, 1, mean))/apply(otu, 1, sd)
avd <- colSums(ai)/(1*nrow(otu))
group<- read.csv("Group.csv",row.names = 1, header = T)
group$AVD <- avd
group

group$diversity <- factor(group$diversity,levels = unique(group$diversity))
group$temperature <- factor(group$temperature,levels = unique(group$temperature))

p5 <- ggplot(group, aes(diversity, AVD)) +
  geom_boxplot(aes(color = diversity), size = 0.8) +
  geom_jitter(aes(color = diversity), width = 0.3, size = 3) +
  scale_color_manual(values = c("#e41a1c", "#377eb8", "#4daf4a","#ff7f00")) +
  theme_bw() +
  theme(legend.position = "none",
        panel.grid = element_blank(),
        axis.text.x = element_text(size = 10),
        axis.text.y = element_text(size = 10),
        axis.title = element_text(size = 14, color = "black"),
        strip.text = element_text(size = 14)) +
  facet_grid(. ~ temperature) +
  ylab("AVD") +
  xlab("Diversity")
p5

comparisons <- list(c("0", "1"),c("0", "3"),c("0", "6"))
diff_t <- t_test(group_by(group, temperature),formula = AVD ~ diversity,
                 comparisons = comparisons)

lab <- add_xy_position(diff_t, x = 'diversity', dodge = 0.65)
lab$p.signif <- ifelse(lab$p < 0.001, "***",
                       ifelse(lab$p < 0.01, "**",
                              ifelse(lab$p < 0.05, "*", "ns")))
p6<-p5 + 
  stat_pvalue_manual(lab, label = "p.signif",
                     label.size = 5,
                     bracket.size = 0.4,
                     tip.length = 0.02)
p6
