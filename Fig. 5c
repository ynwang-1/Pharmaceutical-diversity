otu <- read.csv('otu_represent_result.csv', row.names = 1, check.names = FALSE)

sub_graph <- list()
for (i in names(otu)) {
  sample_i <- otu[i]
  select_node <- rownames(sample_i)[which(sample_i != 0)]
  sub_graph[[i]] <- subgraph(net_igraph, select_node)
}
sub_graph

sample_name <- c()
nodes_num <- c()
degree <- c()
num_edges <- c()
connectance <- c()
centralization_degree <- c()

for(i in 1:length(sub_graph)) {
  sample_name <- c(sample_name, names(sub_graph[i]))
  nodes_num <- c(nodes_num, length(V(sub_graph[[i]])))
  degree <- c(degree, mean(degree(sub_graph[[i]])))
  num_edges <- c(num_edges, gsize(sub_graph[[i]]))
  connectance <- c(connectance, edge_density(sub_graph[[i]], loops = FALSE))
  centralization_degree <- c(centralization_degree, centr_degree(sub_graph[[i]])$centralization)}

sub_graph_stat <- data.frame(
  nodes_num = nodes_num,
  degree = degree,
  num_edges = num_edges,
  connectance = connectance,
  centralization_degree = centralization_degree)

rownames(sub_graph_stat) <- sample_name
head(sub_graph_stat)  
write.csv(sub_graph_stat, 'sub_graph_stat.csv', quote = FALSE)
