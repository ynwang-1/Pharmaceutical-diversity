otu1 <- read.csv("Abundance.csv", header = TRUE, row.names = 1)
otu3 <- otu1[which(rowMeans(otu1) > 0.00001), ]

cor <- rcorr(t(otu3), type = 'spearman')
r = cor$r
p = cor$P 
p <- p.adjust(p, method = 'BH')
r[p>=0.05|abs(r)<0.6] = 0

Sys.setlocale('LC_ALL','C')
diag(r) <- 0

r=r[which(rowSums(abs(r)) > 0),]
r=r[,which(colSums(abs(r)) > 0)]
write.csv(r, "r.csv", row.names = TRUE)

r[1:848, 1:848] <-0
r[849:1174, 849:1174] <-0
write.table (r,file="r_remove.txt", sep="\t", quote =T,col.names = NA)

net_igraph <- graph_from_adjacency_matrix(r,mode="undirected",weighted=TRUE,diag=FALSE)
net_igraph
net_igraph <- simplify(net_igraph)
net_igraph <- delete_vertices(net_igraph, names(degree(net_igraph)[degree(net_igraph) == 0]))
E(net_igraph)$correlation <- E(net_igraph)$weight
E(net_igraph)$weight <- abs(E(net_igraph)$weight)
E(net_igraph)$width = abs(E(net_igraph)$weight)*2.5

col_g <- "#C1C1C1"
cols <- c("#EA9527", "#F16E1D", "#DEB99B", "#5ECC6D", "#5DAFD9", "#7ED1E4",
          "#6E4821", "#A4B423", "#C094DF", "#DC95D8", "#326530", "#50C0C9")
E(net_igraph)$correlation <- E(net_igraph)$weight
E(net_igraph)$weight <- abs(E(net_igraph)$weight)
set.seed(007)
V(net_igraph)$modularity <- membership(cluster_fast_greedy(net_igraph))
V(net_igraph)$label <- V(net_igraph)$name
V(net_igraph)$label <- NA

modu_sort <- V(net_igraph)$modularity %>% table() %>% sort(decreasing = T)
top_num <- 12
modu_name <- names(modu_sort[1:12])
modu_cols <- cols[1:length(modu_name)]
names(modu_cols) <- modu_name

V(net_igraph)$color <- V(net_igraph)$modularity
V(net_igraph)$color[!(V(net_igraph)$color %in% modu_name)] <- col_g
V(net_igraph)$color[(V(net_igraph)$color %in% modu_name)] <- modu_cols[match(V(net_igraph)$color[(V(net_igraph)$color %in% modu_name)], modu_name)]
V(net_igraph)$frame.color <- V(net_igraph)$color
E(net_igraph)$color <- col_g

for (i in modu_name) {
  col_edge <- cols[which(modu_name == i)]
  otu_same_modu <- V(net_igraph)$name[which(V(net_igraph)$modularity == i)]
  E(net_igraph)$color[(data.frame(as_edgelist(net_igraph))$X1 %in% otu_same_modu) & (data.frame(as_edgelist(net_igraph))$X2 %in% otu_same_modu)] <- col_edge
}

