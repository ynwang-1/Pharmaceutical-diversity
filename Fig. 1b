index <- read.delim('diversity.index.txt', header = T, row.names = 1)
index$samples <- rownames(index)

group <- read.csv("Group.csv", header = T)
colnames(group)[1] <- 'samples' 
df2 <- merge(index,group,by = 'samples')
rownames(df2) <- df2[, 1]
df2$diversity <- factor(df2$diversity,levels = unique(df2$diversity))
df2$temperature <- factor(df2$temperature,levels = unique(df2$temperature))

gut <- df2 %>% filter(what == "gut")
p5 <- ggplot(gut, aes(diversity, Shannon)) +
  geom_boxplot(aes(color = diversity), size = 1, width = 0.6) +
  geom_jitter(aes(color = diversity), width = 0.2, size = 6, alpha = 1) +
  scale_color_manual(values = c("#e41a1c", "#377eb8", "#4daf4a","#ff7f00")) +
  geom_signif(comparisons = list(c("0", "1"), c("0", "3"), c("0", "6"), c("3", "6")),
              map_signif_level = TRUE, textsize = 6,
              test = "t.test", step_increase = 0.1) +
  geom_smooth(aes(group = 1),
              method = "glm", se = TRUE,
              color = "black", linewidth = 1) +
  stat_cor(method = "spearman",
           label.y = 3,
           aes(label = paste(..r.label.., ..p.label.., sep = "~`,`~"), group = 1),
           color = "black", label.x = 0.71, size = 6) +
  stat_regline_equation(label.y = 3.1, aes(group = 1),
                        color = "black", label.x = 0.7, size = 6) +
  theme_bw() +
  theme(
    legend.position = "none",
    panel.grid = element_blank(),
    axis.text.x = element_text(size = 12),
    axis.text.y = element_text(size = 12),
    axis.title = element_text(size = 14, color = "black"),
    strip.text = element_text(size = 14)
  ) +
  xlab("Diversity")
p5
