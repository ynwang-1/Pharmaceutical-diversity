df <- read.csv("soil_lifestyle.csv",row.names = 1, header = T)
df$temperature <- as.factor(df$temperature)
df$diversity <- as.factor(df$diversity)

model <- lm(lysogenic ~ diversity, data = df)

shapiro.test(residuals(model))
leveneTest(lysogenic ~ diversity, data=df)

welch <- oneway.test(lysogenic ~ diversity, data = df)
welch

gh <- df %>%
  games_howell_test(lysogenic ~ diversity)

gh

plot_data <- df %>%
  group_by(diversity) %>%
  summarise(
    mean = mean(lysogenic),
    SE = sd(lysogenic)/sqrt(n())
  )

pvals <- gh$p.adj
names(pvals) <- paste(gh$group1, gh$group2, sep="-")
letters <- multcompLetters(pvals)$Letters
plot_data$letters <- letters

p6 <- ggplot(plot_data,
             aes(x = diversity, y = mean, fill = diversity)) +
  geom_bar(stat = "identity", color = "black", width = 0.8) +
  geom_errorbar(aes(ymin = mean - SE, ymax = mean + SE), width = 0.2) +
  geom_text(aes(label = letters, y = mean + SE), vjust = -0.5) +
  scale_y_continuous(name = "soil_lysogenic_ratio") +
  xlab("Diversity") +
  scale_fill_manual(values = c("#e41a1c", "#377eb8", "#4daf4a","#984ea3")) +
  theme_classic() +
  theme(
    axis.line = element_line(),
    axis.text.x = element_text(size = 10),
    axis.text.y = element_text(size = 10),
    axis.title.x = element_text(size = 12),
    axis.title.y = element_text(size = 12),
    legend.position = "none"
  )
p6
